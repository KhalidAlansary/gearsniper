{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": { "includes": ["**", "!sst-env.d.ts"] },
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"includes": ["**", "!./static/"]
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"linter": {
		"rules": {
			"a11y": {
				"useValidLang": "off"
			}
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true
		}
	}
}
