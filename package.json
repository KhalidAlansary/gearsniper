{
	"name": "gearsniper",
	"description": "A marketplace and community for gaming PCs and components.",
	"author": "Khalid Alansary <khaled.ansary2003@outlook.com>",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "playwright install; svelte-kit sync; paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bun run --bun biome check",
		"lint:fix": "bun run --bun biome check --write",
		"test:e2e": "playwright test",
		"test": "bun run test:e2e",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@chromatic-com/storybook": "^5.1.2",
		"@inlang/paraglide-js": "^2.18.0",
		"@playwright/test": "^1.60.0",
		"@storybook/addon-a11y": "^10.3.6",
		"@storybook/addon-docs": "^10.4.0",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.3.6",
		"@storybook/sveltekit": "10.3.6",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^25",
		"@vitest/browser-playwright": "^4.1.6",
		"@vitest/coverage-v8": "^4.1.6",
		"playwright": "^1.60.0",
		"storybook": "^10.3.6",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.12",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"sst": "4.14.1"
	}
}
